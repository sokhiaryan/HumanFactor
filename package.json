{
  "name": "humanfactor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HumanFactor: security awareness survey platform (PRE/POST assessment + analytics)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs && node scripts/check-port.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "prestart": "node scripts/check-node.mjs && node scripts/check-port.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "predb:init": "node scripts/check-node.mjs",
    "db:init": "tsx server/scripts/init-db.ts",
    "db:seed-demo": "tsx server/scripts/seed-demo.ts",
    "db:purge-demo": "tsx server/scripts/purge-demo.ts",
    "predemo:seed": "node scripts/check-node.mjs",
    "demo:seed": "tsx server/scripts/demo-seed.ts",
    "predemo:reset": "node scripts/check-node.mjs",
    "demo:reset": "tsx server/scripts/demo-seed.ts --reset",
    "predemo:verify": "node scripts/check-node.mjs",
    "demo:verify": "tsx server/scripts/demo-verify.ts",
    "demo": "DEMO_INSTANCE=true DATABASE_PATH=${DEMO_DATABASE_PATH:-./data/demo.db} npm run dev",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
