# Copy to .env and fill in real values. Never commit .env.

# Port the API (and, in production, the built website) listens on.
# Hosting platforms usually set PORT for you; API_PORT, if set, takes precedence.
PORT=3000

# Path of the SQLite database file. Put it on a persistent disk when deploying.
DATABASE_PATH=./data/hlac.db

# Shared password for the project team's analytics dashboard (min. 12 characters).
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Secret used to sign dashboard session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters

# Set to "true" when running behind an HTTPS reverse proxy (Render, Railway, Fly, nginx...).
TRUST_PROXY=false

# --- Synthetic demonstration instance (optional) ---------------------------------
# `npm run demo:seed` / `demo:reset` write a synthetic dataset to this separate file
# (never to DATABASE_PATH). `npm run demo` serves the dashboard on it.
DEMO_DATABASE_PATH=./data/demo.db
# Set to "true" only on a server that runs against the demo database; the dashboard and
# exports are then labelled as a synthetic demonstration dataset.
DEMO_INSTANCE=false
